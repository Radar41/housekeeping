#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${ATLAS_PYTHON:-/srv/warm/cluster/atlas/.venv/bin/python}"
[[ -x "$PY" ]] || { echo "Atlas Python missing: $PY" >&2; exit 2; }
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
export ATLAS_FULL_SWEEP=0
# Same as the legacy Atlas slices: workers have no DNS; load the model from the local cache.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
exec "$PY" -m housekeeping.staged "$@"
